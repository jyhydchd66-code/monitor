name: 手机巡查
on:
  schedule:
    - cron: '0 9,13,17,21 * * *'  # 每天4次
  workflow_dispatch:               # 手动触发

jobs:
  patrol:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v2
      - uses: actions/setup-node@v2
        with:
          node-version: '18'
      - run: npm install axios
      - run: node patrol.js
        env:
          DEEPSEEK_API_KEY: ${{ secrets.DEEPSEEK_API_KEY }}